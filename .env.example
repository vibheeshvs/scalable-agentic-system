# --- LLM -------------------------------------------------------------------------
# Default: Gemini on Google AI Studio's free tier (get a key at https://aistudio.google.com).
LLM_MODEL=google_genai:gemini-3.8-flash
GOOGLE_API_KEY=
# A lighter model for the router (it only classifies messages). On the free tier each model has its own
# daily request quota (20/day when I tested), so splitting the calls over two models also doubles what you can run.
ROUTER_MODEL=google_genai:gemini-3.5-flash-lite
# Tried straight away when the main model is overloaded (503) or out of quota:
LLM_FALLBACK_MODEL=google_genai:gemini-3.6-flash
# If a model name stops working, use one listed in AI Studio for your key.

# Other providers work the same way (any tool-calling model langchain's init_chat_model supports):
# LLM_MODEL=openai:gpt-4.1-mini          + OPENAI_API_KEY=
# LLM_MODEL=anthropic:claude-sonnet-4-5  + ANTHROPIC_API_KEY=

# --- retrieval ---------------------------------------------------------------------
EMBEDDINGS=auto            # auto | openai | wordllama | none  (auto = OpenAI if its key is set, else offline WordLlama)
TOOL_TOP_K=8
# CATALOG_PATH=data/catalog/all.json       # 1,095 tools across PayPal/Stripe/Slack/Twilio
# ENABLED_SERVICES=paypal                  # services this user has connected

# --- PayPal: leave empty to use the built-in mock; set both to use the sandbox -------
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# --- safety ------------------------------------------------------------------------
CONFIRM_RISK=high          # comma list of risk levels that need human approval (read,write,high)
MAX_REPAIRS=2

# --- observability (LangSmith) -----------------------------------------------------
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=scalable-agentic-system
